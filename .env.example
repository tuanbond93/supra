# ============================================================
# CẤU HÌNH HỆ THỐNG SUPRA ROUTE OPTIMIZER & EMAIL SYNC
# ============================================================

# 1. TELEGRAM BOT
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id_here

# 2. EMAIL (IMAP) - TỰ ĐỘNG ĐỌC MAIL TỪ DC PHÚ THỌ / MASAN SUPRA
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
# Địa chỉ Email của bạn (ví dụ: tuanns@ghn.vn)
IMAP_USER=your_email@gmail.com
# Mật khẩu ứng dụng 16 ký tự của Google (App Password)
# Cách tạo: Tài khoản Google -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng
IMAP_PASSWORD=your_16_char_app_password

# 3. BỘ LỌC EMAIL (TÙY CHỌN NẾU MUỐN THAY ĐỔI)
# Mặc định lọc theo người gửi masangroup.com / chinhqt@supra.masangroup.com
# MAIL_SENDER_FILTER=chinhqt@supra.masangroup.com
# Mặc định lọc theo tiêu đề 'KẾ HOẠCH XUẤT NVT'
# MAIL_SUBJECT_FILTER=DCPT KẾ HOẠCH XUẤT NVT
